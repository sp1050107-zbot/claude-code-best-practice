{
  "version": "1.0",
  "name": "天氣警報系統",
  "description": "多城市即時天氣監控與警報系統",
  "cities": [
    {
      "name": "Taipei",
      "latitude": 25.033,
      "longitude": 121.5654,
      "timezone": "Asia/Taipei",
      "enabled": true
    },
    {
      "name": "Dubai",
      "latitude": 25.2048,
      "longitude": 55.2708,
      "timezone": "Asia/Dubai",
      "enabled": true
    },
    {
      "name": "Tokyo",
      "latitude": 35.6762,
      "longitude": 139.6503,
      "timezone": "Asia/Tokyo",
      "enabled": true
    },
    {
      "name": "Seoul",
      "latitude": 37.5665,
      "longitude": 126.9780,
      "timezone": "Asia/Seoul",
      "enabled": true
    },
    {
      "name": "Bangkok",
      "latitude": 13.7563,
      "longitude": 100.5018,
      "timezone": "Asia/Bangkok",
      "enabled": true
    }
  ],
  "thresholds": {
    "heat_wave": 35,
    "cold_warning": 0,
    "comfort_min": 15,
    "comfort_max": 28
  },
  "alerts": {
    "heat_wave": {
      "level": "warning",
      "color": "#FF6B6B",
      "emoji": "🌡️",
      "message": "熱浪警報 - 溫度超過 {threshold}°C"
    },
    "cold_warning": {
      "level": "warning",
      "color": "#4ECDC4",
      "emoji": "❄️",
      "message": "寒冷警報 - 溫度低於 {threshold}°C"
    },
    "normal": {
      "level": "info",
      "color": "#95E1D3",
      "emoji": "🌤️",
      "message": "正常 - 溫度在安全範圍內"
    }
  },
  "output": {
    "report_path": "practice/layer-4-orchestration/weather-alert-report.html",
    "data_path": "practice/layer-4-orchestration/outputs",
    "backup_enabled": true,
    "backup_days": 7
  },
  "schedule": {
    "enabled": false,
    "cron": "0 */6 * * *",
    "description": "每 6 小時執行一次"
  }
}